%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 28, "rankSpacing": 38, "padding": 10, "wrappingWidth": 320, "subGraphTitleMargin": {"top": 6, "bottom": 6}}, "themeVariables": {"fontFamily": "'Malgun Gothic', sans-serif", "fontSize": "18px", "edgeLabelBackground": "#FFFFFF", "lineColor": "#5B6B80", "clusterBkg": "#F5F7FA", "clusterBorder": "#9AA8BA"}}}%%
flowchart LR
  subgraph CP["GitHub 서버 — 제어"]
    direction TB
    E["<b>① 이벤트</b><br/>push · PR · 댓글<br/>schedule · 수동 실행"]
    W["<b>② 워크플로 엔진</b><br/>workflows/*.yml 파싱<br/>on: 평가 · needs · matrix<br/>GITHUB_TOKEN 발급"]
    Q["<b>③ Job 큐 · 브로커</b><br/>runs-on 라벨별 대기열"]
    E --> W --> Q
  end

  subgraph RN["Runner — actions/runner"]
    direction TB
    L["<b>④ Runner.Listener</b><br/>long-poll로 job 수신"]
    K["<b>⑤ Runner.Worker</b><br/>action 다운로드<br/>step 실행<br/>run · JS · Docker · composite"]
    L --> K
  end

  subgraph DP["GitHub 서버 — 결과"]
    direction TB
    S[("<b>로그 · 아티팩트 · 캐시</b>")]
    R["<b>⑦ 결과 반영</b><br/>PR 체크 ✅ / ❌<br/>Actions 탭"]
    S --> R
  end

  CP == "HTTPS pull<br/>(Runner → 서버)" ==> RN
  RN == "⑥ 로그 · 결과 보고" ==> DP

  classDef ev fill:#1C7293,stroke:#1C7293,color:#FFFFFF
  classDef eng fill:#002060,stroke:#002060,color:#FFFFFF
