{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier -l --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "test": "bun test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.14.1",
    "uuid": "^11.1.0",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.2.4",
    "prettier": "^3.2.4",
    "typescript": "^5.7.2"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true
  }
}
