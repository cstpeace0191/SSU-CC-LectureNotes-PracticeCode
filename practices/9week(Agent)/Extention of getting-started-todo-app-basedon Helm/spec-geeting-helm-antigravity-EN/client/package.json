{
    "name": "client",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node -e \"const fs = require('fs'); fs.rmSync('../backend/static', { recursive: true, force: true }); fs.cpSync('dist', '../backend/static', { recursive: true });\"",
        "lint": "node -e \"process.env.ESLINT_USE_FLAT_CONFIG = 'false'; const { spawnSync } = require('child_process'); const res = spawnSync('npx', ['eslint', 'src/**/*.{js,jsx}', '--report-unused-disable-directives', '--max-warnings', '0'], { stdio: 'inherit', shell: true }); process.exit(res.status);\"",
        "format": "prettier --config ../.prettierrc --write \"src/**/*.{js,jsx,scss}\"",
        "format-check": "prettier --config ../.prettierrc --check \"src/**/*.{js,jsx,scss}\"",
        "preview": "vite preview",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free-regular": "^5.0.13",
        "@fortawesome/fontawesome-svg-core": "^6.5.1",
        "@fortawesome/free-solid-svg-icons": "^6.5.1",
        "@fortawesome/react-fontawesome": "^0.2.2",
        "bootstrap": "^5.3.6",
        "prop-types": "^15.8.1",
        "react": "^19.1.0",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.5.1",
        "@vitest/coverage-v8": "^3.1.1",
        "axe-core": "^4.10.2",
        "eslint": "^8.55.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "jsdom": "^26.0.0",
        "prettier": "^3.2.4",
        "sass": "^1.62.1",
        "vite": "^6.3.5",
        "vitest": "^3.1.1"
    }
}
